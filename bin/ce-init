#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" == /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
VERSION_FILE="$SCRIPT_DIR/../VERSION"
CHECK_ONLY=0
CLEANUP_LEGACY_TOOL_MAP=0
TARGET_DIR=""
CODEX_BIN="${CODEX_BIN:-$(command -v codex 2>/dev/null || true)}"
TOOL_MAP_BEGIN='<!-- BEGIN COMPOUND CODEX TOOL MAP -->'
TOOL_MAP_END='<!-- END COMPOUND CODEX TOOL MAP -->'

usage() {
  cat <<'EOF'
用法：ce-init [选项] [项目目录]

初始化项目的 Compound Engineering 工作流。项目目录默认为当前目录。

选项：
  --check                    只检查目标项目和旧版 CE tool map，不修改文件
  --cleanup-legacy-tool-map  从 Codex Home 显式清理废弃的 CE tool map
  --help                     显示帮助
  --version                  显示版本
EOF
}

fail() {
  echo "Error: $*" >&2
  exit 1
}

codex_agents_files() {
  local active_home="${CODEX_HOME:-$HOME/.codex}"
  local profiles_root
  {
    [[ -f "$active_home/AGENTS.md" ]] && printf '%s\n' "$active_home/AGENTS.md"
    [[ -f "$HOME/.codex/AGENTS.md" ]] && printf '%s\n' "$HOME/.codex/AGENTS.md"
    for profiles_root in "$active_home/profiles" "$HOME/.codex/profiles"; do
      if [[ -d "$profiles_root" ]]; then
        find "$profiles_root" -mindepth 2 -maxdepth 2 \( -type f -o -type l \) -name AGENTS.md -print
      fi
    done
  } | awk '!seen[$0]++'
}

legacy_tool_map_state() {
  local file="$1"
  awk -v begin="$TOOL_MAP_BEGIN" -v end="$TOOL_MAP_END" '
    { line=$0; sub(/\r$/, "", line) }
    line == begin { if (inside) bad=1; inside=1; found=1; next }
    line == end { if (!inside) bad=1; inside=0; next }
    END {
      if (bad || inside) exit 2
      if (!found) exit 1
    }
  ' "$file" >/dev/null
}

cleanup_legacy_tool_maps() {
  local file state temporary mode line comparison read_status inside cleaned=0 file_count=0
  local -a files=()
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    files[${#files[@]}]="$file"
    file_count=$((file_count + 1))
  done < <(codex_agents_files)
  if [[ "$file_count" -eq 0 ]]; then
    echo "未发现旧版 CE tool map"
    return
  fi
  for file in "${files[@]}"; do
    if legacy_tool_map_state "$file"; then
      state=0
    else
      state=$?
    fi
    if [[ "$state" -eq 1 ]]; then
      continue
    fi
    if [[ "$state" -ne 0 ]]; then
      fail "旧版 CE tool map 标记不完整，未修改：$file"
    fi
    [[ ! -L "$file" ]] || fail "旧版 CE tool map 位于符号链接，未修改：$file"
  done
  for file in "${files[@]}"; do
    if ! legacy_tool_map_state "$file"; then
      continue
    fi
    temporary="$(mktemp "${file}.tmp.XXXXXX")"
    inside=0
    while true; do
      if IFS= read -r line; then
        read_status=0
      else
        read_status=$?
      fi
      [[ "$read_status" -eq 0 || -n "$line" ]] || break
      comparison="${line%$'\r'}"
      if [[ "$comparison" == "$TOOL_MAP_BEGIN" ]]; then
        inside=1
      elif [[ "$comparison" == "$TOOL_MAP_END" ]]; then
        inside=0
      elif [[ "$inside" -eq 0 ]]; then
        printf '%s' "$line" >> "$temporary"
        [[ "$read_status" -ne 0 ]] || printf '\n' >> "$temporary"
      fi
      [[ "$read_status" -eq 0 ]] || break
    done < "$file"
    if ! mode="$(stat -f '%Lp' "$file" 2>/dev/null || stat -c '%a' "$file")" ||
       ! chmod "$mode" "$temporary" ||
       ! mv "$temporary" "$file"; then
      rm -f "$temporary"
      fail "无法原子清理旧版 CE tool map：$file"
    fi
    echo "已清理旧版 CE tool map：$file"
    cleaned=1
  done
  [[ "$cleaned" -eq 1 ]] || echo "未发现旧版 CE tool map"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) CHECK_ONLY=1 ;;
    --cleanup-legacy-tool-map) CLEANUP_LEGACY_TOOL_MAP=1 ;;
    --help|-h) usage; exit 0 ;;
    --version)
      [[ -f "$VERSION_FILE" ]] && cat "$VERSION_FILE" || echo "development"
      exit 0
      ;;
    --*) fail "未知选项：$1" ;;
    *)
      [[ -z "$TARGET_DIR" ]] || fail "只能指定一个项目目录"
      TARGET_DIR="$1"
      ;;
  esac
  shift
done

if [[ "$CLEANUP_LEGACY_TOOL_MAP" -eq 1 ]]; then
  [[ "$CHECK_ONLY" -eq 0 ]] || fail "--check 与 --cleanup-legacy-tool-map 不能同时使用"
  [[ -z "$TARGET_DIR" ]] || fail "--cleanup-legacy-tool-map 不接受项目目录"
  cleanup_legacy_tool_maps
  exit 0
fi

TARGET_DIR="${TARGET_DIR:-$PWD}"

if [[ -n "${CE_INIT_TEMPLATE:-}" ]]; then
  TEMPLATE="$CE_INIT_TEMPLATE"
elif [[ -f "$SCRIPT_DIR/../templates/AGENTS.md" ]]; then
  TEMPLATE="$SCRIPT_DIR/../templates/AGENTS.md"
else
  TEMPLATE="${XDG_DATA_HOME:-$HOME/.local/share}/ce-init/templates/AGENTS.md"
fi

[[ -f "$TEMPLATE" ]] || fail "CE 规则模板不存在：$TEMPLATE"
[[ -n "$CODEX_BIN" && -x "$CODEX_BIN" ]] || fail "找不到 Codex CLI，请先安装 Codex"

PLUGIN_LINE="$("$CODEX_BIN" plugin list 2>/dev/null | awk '$1 == "compound-engineering@compound-engineering-plugin" && $0 ~ /installed, enabled/ {print; exit}')"
[[ -n "$PLUGIN_LINE" ]] || fail "官方 Compound Engineering 插件未安装或未启用。请先执行：codex plugin marketplace add EveryInc/compound-engineering-plugin && codex plugin add compound-engineering@compound-engineering-plugin"

PLUGIN_ROOT="$(printf '%s\n' "$PLUGIN_LINE" | awk -F '  +' '{print $NF}')"
CONFIG_TEMPLATE="$PLUGIN_ROOT/skills/ce-setup/references/config-template.yaml"
[[ -f "$CONFIG_TEMPLATE" ]] || fail "找不到官方 CE 配置模板：$CONFIG_TEMPLATE"

if [[ "$CHECK_ONLY" -eq 1 ]]; then
  [[ -d "$TARGET_DIR" ]] || fail "项目目录不存在：$TARGET_DIR"
  TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
  issues=0
  [[ -f "$TARGET_DIR/AGENTS.md" ]] || { echo "缺失：AGENTS.md"; issues=1; }
  for artifact_dir in brainstorms plans reviews solutions; do
    [[ -f "$TARGET_DIR/docs/$artifact_dir/.gitkeep" ]] || { echo "缺失：docs/$artifact_dir/.gitkeep"; issues=1; }
  done
  if [[ ! -f "$TARGET_DIR/.compound-engineering/config.local.example.yaml" ]]; then
    echo "缺失：.compound-engineering/config.local.example.yaml"
    issues=1
  elif ! cmp -s "$CONFIG_TEMPLATE" "$TARGET_DIR/.compound-engineering/config.local.example.yaml"; then
    echo "过期：.compound-engineering/config.local.example.yaml（运行 \$ce-setup 刷新）"
    issues=1
  fi
  grep -Eq '^\.compound-engineering/(config\.local\.yaml|\*\.local\.yaml)$' "$TARGET_DIR/.gitignore" 2>/dev/null || { echo "缺失：.gitignore 中的 CE 本地配置规则"; issues=1; }
  while IFS= read -r agents_file; do
    [[ -n "$agents_file" ]] || continue
    if legacy_tool_map_state "$agents_file"; then
      state=0
    else
      state=$?
    fi
    if [[ "$state" -eq 0 ]]; then
      echo "废弃：旧版 CE tool map：${agents_file}（运行 ce-init --cleanup-legacy-tool-map）"
      issues=1
    elif [[ "$state" -eq 2 ]]; then
      echo "错误：旧版 CE tool map 标记不完整：$agents_file"
      issues=1
    fi
  done < <(codex_agents_files)
  [[ "$issues" -eq 0 ]] && echo "CE 初始化状态正常：$TARGET_DIR"
  exit "$issues"
fi

mkdir -p "$TARGET_DIR"
TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
AGENTS_FILE="$TARGET_DIR/AGENTS.md"
CE_FILE="$TARGET_DIR/CE_AGENTS.md"
CONFIG_DIR="$TARGET_DIR/.compound-engineering"
CONFIG_EXAMPLE="$CONFIG_DIR/config.local.example.yaml"
GITIGNORE="$TARGET_DIR/.gitignore"

mkdir -p \
  "$TARGET_DIR/docs/brainstorms" \
  "$TARGET_DIR/docs/plans" \
  "$TARGET_DIR/docs/reviews" \
  "$TARGET_DIR/docs/solutions" \
  "$CONFIG_DIR"

for artifact_dir in brainstorms plans reviews solutions; do
  touch "$TARGET_DIR/docs/$artifact_dir/.gitkeep"
done

if [[ ! -e "$CONFIG_EXAMPLE" ]]; then
  cp "$CONFIG_TEMPLATE" "$CONFIG_EXAMPLE"
  echo "已创建：.compound-engineering/config.local.example.yaml"
elif ! cmp -s "$CONFIG_TEMPLATE" "$CONFIG_EXAMPLE"; then
  echo "已保留现有 CE 配置示例；请运行 \$ce-setup 检查并刷新"
fi

if ! grep -Eq '^\.compound-engineering/(config\.local\.yaml|\*\.local\.yaml)$' "$GITIGNORE" 2>/dev/null; then
  if [[ -s "$GITIGNORE" ]] && [[ "$(tail -c 1 "$GITIGNORE" | wc -l | tr -d ' ')" == "0" ]]; then
    printf '\n' >> "$GITIGNORE"
  fi
  printf '.compound-engineering/config.local.yaml\n' >> "$GITIGNORE"
  echo "已更新：.gitignore"
fi

if [[ ! -e "$AGENTS_FILE" ]]; then
  cp "$TEMPLATE" "$AGENTS_FILE"
  echo "已从 CE 模板创建 AGENTS.md：$TARGET_DIR"
elif [[ ! -e "$CE_FILE" ]]; then
  cp "$TEMPLATE" "$CE_FILE"
  echo "已保留现有 AGENTS.md，并创建待人工合并的 CE_AGENTS.md"
elif cmp -s "$TEMPLATE" "$CE_FILE"; then
  echo "已保留现有 AGENTS.md；CE_AGENTS.md 已是当前版本"
else
  echo "已保留现有 AGENTS.md 和 CE_AGENTS.md；请从以下模板人工合并：$TEMPLATE"
fi

echo "已创建 CE 产物目录及 .gitkeep：$TARGET_DIR/docs"
echo "下一步：审阅生成文件，然后在 Codex 中运行 \$ce-setup"
